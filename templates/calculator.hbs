<div class="travel-calculator">
	<div class="header-group mode-group">
		<label>{{localize "TRAVELPACE.Labels.CalculationMode"}}</label>
		<div class="mode-selector">
			{{#each modes}}
				<label class="radio-label">
					<input type="radio" name="travelpace-mode" value="{{this.id}}" {{#if (eq this.id "distance")}}checked{{/if}}>
					{{localize this.label}}
				</label>
			{{/each}}
		</div>
	</div>
	<hr />

	<div class="distance-to-time">
		<div class="form-group">
			<label for="travelpace-distance">{{localize "TRAVELPACE.Labels.Distance"}} ({{unit}})</label>
			<input type="number" id="travelpace-distance" placeholder="0" min="0" step="0.1" required>
		</div>
	</div>

	<div class="time-to-distance" hidden>
		<div class="form-group">
			<label for="travelpace-days">{{localize "TRAVELPACE.Labels.Days"}}</label>
			<input type="number" id="travelpace-days" value="0" min="0">
		</div>

		<div class="form-group">
			<label for="travelpace-hours">{{localize "TRAVELPACE.Labels.Hours"}}</label>
			<input type="number" id="travelpace-hours" value="0" min="0" max="23">
		</div>
	</div>

	<div class="form-group">
		<label for="travelpace-pace">{{localize "TRAVELPACE.Labels.Pace"}}</label>
		<select id="travelpace-pace">
			{{#each paces}}
				<option value="{{this.id}}" {{#if (eq this.id "normal")}}selected{{/if}}>{{localize this.label}}</option>
			{{/each}}
		</select>
	</div>

	{{#if mounts.length}}
		<div class="form-group">
			<label for="travelpace-mount">{{localize "TRAVELPACE.Labels.TransportationMethod"}}</label>
			<select id="travelpace-mount">
				<option value="">{{localize "TRAVELPACE.Labels.NoMount"}}</option>
				{{#each mounts}}
					<option value="{{this.uuid}}">{{this.name}}</option>
				{{/each}}
			</select>
		</div>
	{{/if}}

	<div class="calculation-preview-container">
		<h3>{{localize "TRAVELPACE.Preview.Title"}}</h3>
		<div class="calculation-preview" role="status" aria-live="polite">
			{{localize "TRAVELPACE.Preview.Empty"}}
		</div>
	</div>

	<div class="form-buttons">
		<button type="button" data-action="submitCalculation" class="submit-button">
			<i class="fas fa-comments"></i>
			{{localize "TRAVELPACE.Buttons.Calculate"}}
		</button>
	</div>
</div>
