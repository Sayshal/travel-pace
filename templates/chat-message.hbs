<div class="travel-pace-chat">
  <h2>{{localize "TRAVELPACE.ChatMessage.Title"}}</h2>

  {{#if mountEmbed}}
    <p class="travel-pace-mount">{{localize "TRAVELPACE.ChatMessage.UsingMount" mount=mountEmbed speed=mountSpeed}}</p>
  {{/if}}

  {{#if modifierLines.length}}
    <div class="travel-pace-modifiers">
      {{#each modifierLines}}
        <p>{{this}}</p>
      {{/each}}
    </div>
  {{/if}}

  <div class="travel-pace-details">
    <p class="travel-pace-pace">{{localize "TRAVELPACE.ChatMessage.PaceLine" pace=paceLabel}}</p>

    {{#if (eq result.mode "distance")}}
      <p class="travel-pace-input">{{localize "TRAVELPACE.ChatMessage.DistanceLine" distance=distanceText}}</p>
      <p class="travel-pace-output">{{localize "TRAVELPACE.ChatMessage.TimeLine" time=timeText}}</p>
    {{else}}
      <p class="travel-pace-input">{{localize "TRAVELPACE.ChatMessage.TimeLine" time=timeText}}</p>
      <p class="travel-pace-output">{{localize "TRAVELPACE.ChatMessage.DistanceLine" distance=distanceText}}</p>
    {{/if}}
  </div>

  {{#if showEffects}}
    <div class="travel-pace-effects">
      <p>{{result.paceEffect}}</p>
    </div>
  {{/if}}

  {{#if result.output.totalMinutes}}
    <button type="button" class="travel-pace-advance">
      <i class="fas fa-forward"></i>
      {{localize "TRAVELPACE.Advance.Button"}}
    </button>
  {{/if}}
</div>
