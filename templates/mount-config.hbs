<div class="travel-pace-mount-config">
	<p class="hint">{{localize "TRAVELPACE.Settings.MountConfig.Instructions"}}</p>

	{{#if actors.length}}
		<h3>{{localize "TRAVELPACE.Settings.MountConfig.SelectMounts"}}</h3>
		{{formField fields.mounts widget=mountsWidget}}
	{{else}}
		<div class="notification error">
			<p>{{localize "TRAVELPACE.Settings.MountConfig.NoMounts"}}</p>
			<p>{{localize "TRAVELPACE.Settings.MountConfig.AddMountsHint"}}</p>
		</div>
	{{/if}}
</div>
