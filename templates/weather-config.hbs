<div class="travel-pace-weather-config standard-form">
	{{!-- Instructions --}}
	<p class="hint" id="travelpace-weather-instructions">{{localize "TravelPace.Settings.WeatherConfig.Instructions"}}</p>

	{{!-- Weather Presets --}}
	<fieldset class="travel-pace-weather-presets">
		<legend>{{localize "TravelPace.Settings.WeatherConfig.Presets"}}</legend>
		{{#each presets}}
			<div class="form-group">
				<label for="travelpace-weather-preset-{{this.id}}">
					<i class="{{this.icon}}" style="color: {{this.color}}"></i>
					{{this.label}}
				</label>
				<div class="form-fields">
					<input type="number" id="travelpace-weather-preset-{{this.id}}" name="preset.{{this.id}}" value="{{this.multiplier}}" min="0.1" max="5" step="0.05" />
				</div>
			</div>
		{{else}}
			<p class="notification warning" id="travelpace-weather-warning">{{localize "TravelPace.Settings.WeatherConfig.NoPresets"}}</p>
		{{/each}}
	</fieldset>

	{{!-- Severity Table --}}
	<fieldset class="travel-pace-weather-severity">
		<legend>{{localize "TravelPace.Settings.WeatherConfig.Severity"}}</legend>
		<p class="hint">{{localize "TravelPace.Settings.WeatherConfig.SeverityHint"}}</p>
		{{#each severities}}
			<div class="form-group">
				<label for="travelpace-weather-severity-{{this.id}}">{{this.label}}</label>
				<div class="form-fields">
					<input type="number" id="travelpace-weather-severity-{{this.id}}" name="severity.{{this.id}}" value="{{this.multiplier}}" min="0.1" max="5" step="0.05" />
				</div>
			</div>
		{{else}}
			<p class="notification warning">{{localize "TravelPace.Settings.WeatherConfig.NoPresets"}}</p>
		{{/each}}
	</fieldset>
</div>
